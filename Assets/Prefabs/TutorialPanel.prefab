  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022 <b>\u0110\u1ED9 b\u1EC1n c\u1EE7a tr\u1EE9ng:</b> Tr\xE1nh \u0111\u1EC3
    t\u1ED5 va qu\u1EC7t m\u1EA1nh v\xE0o v\xE1ch n\xFAi ho\u1EB7c ch\u01B0\u1EDBng
    ng\u1EA1i v\u1EADt. Va \u0111\u1EADp m\u1EA1nh c\xF3 th\u1EC3 l\xE0m n\u1EE9t
    ho\u1EB7c v\u1EE1 tr\u1EE9ng!\n\n\u2022 <b>\u0110i\u1EC3m h\u1ED3i sinh (Checkpoint):</b>
    Khi tr\u1EE9ng b\u1ECB v\u1EE1 ho\u1EB7c hai b\u1EA1n r\u01A1i v\u1EF1c, \u0111\u1ED9i
    s\u1EBD \u0111\u01B0\u1EE3c h\u1ED3i sinh t\u1EA1i Checkpoint g\u1EA7n nh\u1EA5t.\n\n\u2022
    <b>Chi\u1EBFn th\u1EAFng:</b> H\xE3y c\xF9ng nhau leo l\xEAn \u0111\u1EC9nh v\xE0
    \u0111\u01B0a chi\u1EBFc t\u1ED5 ch\u1EA1m v\xE0o <color=#FBD38D><b>V\xF9ng \u0110\xEDch
    (Win Area)</b></color> \u0111\u1EC3 gi\xE0nh chi\u1EBFn th\u1EAFng!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5b89710dea255ae4fa799a0af4200fe3, type: 2}
