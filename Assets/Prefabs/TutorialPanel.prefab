      m_Calls: []
  m_text: "\u2022 Nh\u1EA5n ph\xEDm <b>Space</b> \u0111\u1EC3 nh\u1EA3y l\xEAn c\xE1c
    kh\u1ED1i \u0111\xE1 v\xE0 v\u01B0\u1EE3t qua ch\u01B0\u1EDBng ng\u1EA1i v\u1EADt.\n\n\u2022
    <b>Nh\u1EA3y \u0111\u1ED3ng b\u1ED9:</b> Khi g\u1EB7p g\u1EDD cao, c\u1EA3 hai
    ng\u01B0\u1EDDi ch\u01A1i c\u1EA7n <b>c\xF9ng nh\u1EA3y \u0103n \xFD</b> v\u1EDBi
    nhau.\n\n\u2022 <b>C\u1EA3nh b\xE1o:</b> N\u1EBFu m\u1ED9t ng\u01B0\u1EDDi nh\u1EA3y
    m\xE0 ng\u01B0\u1EDDi kia \u0111\u1EE9ng y\xEAn, t\u1ED5 s\u1EBD b\u1ECB l\u1EADt
    nghi\xEAng sang m\u1ED9t b\xEAn khi\u1EBFn tr\u1EE9ng r\u01A1i v\u1EF1c ngay
    l\u1EADp t\u1EE9c!"
  m_isRightToLeft: 0
